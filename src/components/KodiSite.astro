---
// Sitedeki Kodi. Görünüşü TürKod programındaki Kodi'nin aynısı (robot çizimi
// src/data/kodi-ciz.ts, balon programdaki _KodiBalonu'nun ölçüleri). Yapay zekâ
// KULLANMAZ: bilgi tabanı, sözlük ve site aramasıyla cevap verir. İsteğe bağlı Vikipedi araması
// varsayılan kapalıdır; açıkken de her aramadan önce kullanıcıya sorar.
// Sohbet, açık/kapalı durumu ve Kodi'nin yeri sayfalar arasında korunur.
---
<div class="tkk-robot-kutu" data-kodi-robot-kutu>
  <div class="tkk-ipucu" hidden data-kodi-ipucu>Bir sorun mu var? Bana sor!</div>
  <canvas class="tkk-robot" data-kodi-robot role="button" tabindex="0" aria-label="Kodi ile konuş (sürükleyerek taşıyabilirsin)" aria-expanded="false"></canvas>
</div>

<section class="tkk-balon" role="dialog" aria-label="Kodi" hidden data-kodi-balon>
  <svg class="tkk-kuyruk" data-kodi-kuyruk width="24" height="12" viewBox="0 0 24 12" aria-hidden="true">
    <path class="tkk-kuyruk-zemin" d="M0 0 Q16 4 22 11 Q16 2 20 0 Z" />
    <path class="tkk-kuyruk-kenar" d="M0 0.7 Q16 4 22 11 Q16 2 20 0.7" />
  </svg>
  <div class="tkk-kutu">
    <div class="tkk-baslik">
      <span class="tkk-ad">Kodi</span>
      <span class="tkk-nokta" title="Kodi bu sitede hazır bilgilerle cevap veriyor"></span>
      <span class="tkk-bosluk"></span>
      <button type="button" class="tkk-dugme tkk-internet" data-kodi-internet aria-pressed="false"
              title="İnternette arama kapalı. Açarsan Kodi bulamadığı soruları Vikipedi'de aramayı önerir (her seferinde sorar)."
              aria-label="İnternette arama (Vikipedi)">
        <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm6.93 6h-2.95a15.6 15.6 0 0 0-1.38-3.56A8.03 8.03 0 0 1 18.93 8ZM12 4.04c.83 1.2 1.48 2.53 1.91 3.96h-3.82c.43-1.43 1.08-2.76 1.91-3.96ZM4.26 14a7.8 7.8 0 0 1 0-4h3.38a16.5 16.5 0 0 0 0 4H4.26Zm.81 2h2.95c.32 1.25.78 2.45 1.38 3.56A7.99 7.99 0 0 1 5.07 16Zm2.95-8H5.07a7.99 7.99 0 0 1 4.33-3.56A15.6 15.6 0 0 0 8.02 8ZM12 19.96A14.1 14.1 0 0 1 10.09 16h3.82A14.1 14.1 0 0 1 12 19.96ZM14.34 14H9.66a14.7 14.7 0 0 1 0-4h4.68a14.7 14.7 0 0 1 0 4Zm.25 5.56c.6-1.11 1.06-2.31 1.38-3.56h2.95a8.03 8.03 0 0 1-4.33 3.56ZM16.36 14a16.5 16.5 0 0 0 0-4h3.38a7.8 7.8 0 0 1 0 4h-3.38Z" fill="currentColor"/></svg>
      </button>
      <button type="button" class="tkk-dugme" data-kodi-yeni title="Yeni sohbet" aria-label="Yeni sohbet">
        <svg viewBox="0 0 24 24"><path d="M17.65 6.35A7.96 7.96 0 0 0 12 4a8 8 0 1 0 7.73 10h-2.08A6 6 0 1 1 12 6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35Z" fill="currentColor"/></svg>
      </button>
      <button type="button" class="tkk-dugme" data-kodi-kapat title="Kapat" aria-label="Kapat">
        <svg viewBox="0 0 24 24"><path d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12Z" fill="currentColor"/></svg>
      </button>
    </div>
    <div class="tkk-akis" data-kodi-akis aria-live="polite"></div>
    <form class="tkk-giris" data-kodi-form>
      <input type="text" data-kodi-giris placeholder="Kodi'ye bir şey sor…" autocomplete="off" maxlength="200" aria-label="Kodi'ye sor" />
      <button type="submit" class="tkk-gonder" title="Gönder (Enter)" aria-label="Gönder">
        <svg viewBox="0 0 24 24"><path d="M2.01 21 23 12 2.01 3 2 10l15 2-15 2z" fill="currentColor"/></svg>
      </button>
    </form>
  </div>
</section>

<script>
  import { DOLGU, baglamliCevap, bolumDizini, katla, sadelestir, sozlukDizini, takipMi, type BolumDizini, type KodiCevap, type SozlukDizini } from '../data/kodi-motor';
  import type { HesapBaglami } from '../data/kodi-hesap';
  import { kodiCiz, type KodiIfadesi } from '../data/kodi-ciz';

  // Bilgi tabanı (≈470 madde) ve hesap motoru büyük: her sayfada değil, Kodi açılınca arka planda yüklenir.
  let bilgiMod: Promise<typeof import('../data/kodi-bilgi')> | null = null;
  const bilgiAl = () => (bilgiMod ??= import('../data/kodi-bilgi'));
  let hesapMod: Promise<typeof import('../data/kodi-hesap')> | null = null;
  const hesapAl = () => (hesapMod ??= import('../data/kodi-hesap'));

  type Baglanti = { t: string; u: string };
  type Mesaj = {
    kim: 'kodi' | 'sen'; metin: string; kod?: string; linkler?: Baglanti[];
    /** Kodi'nin "Vikipedi'de arayayım mı?" sorusu: aranacak soru, (takip sorusunda) bakılacak madde, cevap. */
    vikiSoru?: { soru: string; baslik?: string; cevap?: 'evet' | 'hayir' };
    /** Kullanıcının "Evet, ara" cevabı: sayfa değişirse arama buradan sürer. */
    vikiAra?: string;
    vikiBaslik?: string;
  };
  /** Sohbetin son konusu: bilgi tabanındaki bir madde ya da bir Vikipedi maddesi (takip soruları için). */
  type Konu = { tur: 'bilgi'; soru: string; id?: string } | { tur: 'viki'; baslik: string; soru: string };
  type Durum = {
    acik: boolean;
    mesajlar: Mesaj[];
    soruldu: boolean;
    konum: { x: number; y: number } | null;
    taslak: string;
    kaydirma: number;
    ipucu: boolean;
    /** İnternette (Vikipedi) arama düğmesi; varsayılan kapalı. */
    internet: boolean;
    konu: Konu | null;
    /** Son hesap (takip soruları için: "peki 2 ile çarparsam?", "kodunu göster") */
    hesap: HesapBaglami | null;
  };

  const GITHUB = 'https://github.com/YusufX-sys/turkod-ide';
  const SELAM = "Merhaba, ben Kodi! TürKod'u ya da kodlamayı merak ettiğin ne varsa sorabilirsin: değişkenler, döngüler, hatalar, sözlükteki kelimeler... "
    + 'Matematik problemlerini de kod yazıp çalıştırarak çözerim. Hadi bakalım!';
  const HAZIR_SORULAR = ['Değişken nedir?', 'Döngü nasıl yazılır?', 'yazdır ne demek?', '3x + 5 = 20 ise x kaç?',
    "Ali'nin 5 elması var, 3 tane daha aldı. Kaç elması oldu?", "TürKod'u nasıl kurarım?", 'Bana bir şaka yap!'];
  const ANAHTAR = 'tk-kodi-durum';
  const ROBOT_G = 84;
  const ROBOT_Y = 109;

  // ------------------------------------------------------------------ durum
  const bos = (): Durum => ({ acik: false, mesajlar: [], soruldu: false, konum: null, taslak: '', kaydirma: 0, ipucu: false, internet: false, konu: null, hesap: null });
  let durum: Durum = bos();
  try {
    const k = sessionStorage.getItem(ANAHTAR);
    if (k) durum = { ...bos(), ...JSON.parse(k) };
  } catch { /* depolama yoksa her sayfa yeni başlar */ }
  const kaydet = () => {
    try { sessionStorage.setItem(ANAHTAR, JSON.stringify(durum)); } catch { /* yok say */ }
  };

  // Sözlük verisi (≈100 KB) yalnızca ilk soruda indirilir.
  let sozluk: Promise<SozlukDizini | null> | null = null;
  const sozlukAl = () =>
    (sozluk ??= fetch('/kodi-sozluk.json')
      .then((r) => (r.ok ? r.json() : null))
      .then((v) => (v?.k ? sozlukDizini(v.k) : null))
      .catch(() => null));
  // Belge bölümleri (derlemede üretilir, ≈120 KB): Kodi ayrıntılı soruları buradan cevaplar.
  let bolumler: Promise<BolumDizini | null> | null = null;
  const bolumAl = () =>
    (bolumler ??= fetch('/kodi-bolumler.json')
      .then((r) => (r.ok ? r.json() : null))
      .then((v) => (v?.b?.length ? bolumDizini(v.b) : null))
      .catch(() => null));

  const robotKutu = document.querySelector<HTMLElement>('[data-kodi-robot-kutu]');
  const balon = document.querySelector<HTMLElement>('[data-kodi-balon]');

  if (robotKutu && balon) {
    // Alt bilgi bulanıklık efektli <main> içinde; 'fixed' ekrana göre çalışsın diye body'ye taşınır.
    document.body.append(robotKutu, balon);
    const tuval = robotKutu.querySelector<HTMLCanvasElement>('[data-kodi-robot]')!;
    const ipucu = robotKutu.querySelector<HTMLElement>('[data-kodi-ipucu]')!;
    const kuyruk = balon.querySelector<SVGElement>('[data-kodi-kuyruk]')!;
    const akis = balon.querySelector<HTMLElement>('[data-kodi-akis]')!;
    const form = balon.querySelector<HTMLFormElement>('[data-kodi-form]')!;
    const giris = balon.querySelector<HTMLInputElement>('[data-kodi-giris]')!;
    const azHareket = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let mesgul = false;

    // ---------------------------------------------------------------- robot
    let ifade: KodiIfadesi = 'mutlu';
    let elSallaBitis = 0;
    let goz = 1;
    let kirpBaslangic = -1;
    let sonrakiKirp = performance.now() + 2500;
    const ctx = tuval.getContext('2d')!;
    const tuvalBoyutla = () => {
      const o = Math.min(window.devicePixelRatio || 1, 3);
      tuval.width = Math.round(ROBOT_G * o);
      tuval.height = Math.round(ROBOT_Y * o);
      ctx.setTransform(o, 0, 0, o, 0, 0);
    };
    tuvalBoyutla();
    // Programdaki gibi: hareket varken ~24, boştayken ~12 kare/sn. Döngü yalnızca çizim zamanı
    // gelince uyanır (eskiden her ekran karesinde, saniyede 60 kez uyanıyordu) ve sekme gizliyken durur.
    let zamanlayiciKodi: ReturnType<typeof setTimeout> | null = null;
    const sonrakiKare = () => {
      if (azHareket || document.hidden || zamanlayiciKodi) return;
      const etkin = ifade !== 'mutlu' || performance.now() < elSallaBitis;
      zamanlayiciKodi = setTimeout(() => { zamanlayiciKodi = null; requestAnimationFrame(ciz); }, etkin ? 42 : 83);
    };
    document.addEventListener('visibilitychange', () => { if (!document.hidden) sonrakiKare(); });
    const ciz = (an: number) => {
      {
        if (!azHareket) {
          if (kirpBaslangic < 0 && an > sonrakiKirp) kirpBaslangic = an;
          if (kirpBaslangic >= 0) {
            const g = (an - kirpBaslangic) / 180;
            goz = g >= 1 ? 1 : Math.abs(1 - 2 * g);
            if (g >= 1) { kirpBaslangic = -1; sonrakiKirp = an + 2200 + Math.random() * 3800; }
          }
        }
        kodiCiz(ctx, ROBOT_G, ROBOT_Y, {
          ifade,
          t: azHareket ? 0 : (an % 2600) / 2600,
          goz,
          agiz: ifade === 'konusuyor' ? 0.5 + 0.5 * Math.sin(an / 55) : 0,
          elSalla: an < elSallaBitis,
        });
      }
      sonrakiKare();
    };
    requestAnimationFrame(ciz);
    window.addEventListener('resize', () => { tuvalBoyutla(); yerlestir(); });
    const elSalla = (ms = 1800) => { elSallaBitis = performance.now() + ms; };

    // ---------------------------------------------------------------- yerleşim
    const KENAR = 12;
    const robotKonumu = () => {
      const g = window.innerWidth, y = window.innerHeight;
      const k = durum.konum ?? { x: g - ROBOT_G - 18, y: y - ROBOT_Y - 10 };
      return { x: Math.min(Math.max(k.x, 4), g - ROBOT_G - 4), y: Math.min(Math.max(k.y, 4), y - ROBOT_Y - 4) };
    };
    const yerlestir = () => {
      const r = robotKonumu();
      robotKutu.style.left = `${r.x}px`;
      robotKutu.style.top = `${r.y}px`;
      if (balon.hidden) return;
      const gen = Math.min(370, window.innerWidth - 2 * KENAR);
      balon.style.width = `${gen}px`;
      const merkez = r.x + ROBOT_G / 2;
      const ustBosluk = r.y - KENAR - 8;
      const altBosluk = window.innerHeight - (r.y + ROBOT_Y) - KENAR - 8;
      const ustte = ustBosluk >= Math.min(320, altBosluk) ;
      const enFazla = Math.min(560, ustte ? ustBosluk : altBosluk);
      balon.style.maxHeight = `${Math.max(220, enFazla)}px`;
      const sol = Math.min(Math.max(merkez - gen + 46, KENAR), window.innerWidth - gen - KENAR);
      balon.style.left = `${sol}px`;
      const yuk = balon.offsetHeight;
      balon.style.top = ustte ? `${Math.max(KENAR, r.y + 6 - yuk)}px` : `${r.y + ROBOT_Y - 6}px`;
      balon.classList.toggle('tkk-altta', !ustte);
      // Kuyruk Kodi'nin başını gösterir (programdaki kuyrukX).
      const kx = Math.min(Math.max(merkez - sol, 24), gen - 24);
      kuyruk.style.left = `${kx - 12}px`;
    };
    // Balon büyüdükçe yeri kare başına en fazla bir kez hesaplanır (yazma efektinde her harfte değil).
    let yerlestirBekliyor = false;
    new ResizeObserver(() => {
      if (yerlestirBekliyor) return;
      yerlestirBekliyor = true;
      requestAnimationFrame(() => { yerlestirBekliyor = false; yerlestir(); });
    }).observe(balon);

    // ---------------------------------------------------------------- sürükleme
    // Programdaki gibi: Kodi'ye basıp sürükle; yerini hatırlar; çift tıklayınca köşesine döner.
    let surukle: { dx: number; dy: number; x0: number; y0: number; oynadi: boolean } | null = null;
    tuval.addEventListener('pointerdown', (e) => {
      const r = robotKonumu();
      surukle = { dx: e.clientX - r.x, dy: e.clientY - r.y, x0: e.clientX, y0: e.clientY, oynadi: false };
      tuval.setPointerCapture(e.pointerId);
    });
    tuval.addEventListener('pointermove', (e) => {
      if (!surukle) return;
      if (!surukle.oynadi && Math.hypot(e.clientX - surukle.x0, e.clientY - surukle.y0) < 5) return;
      surukle.oynadi = true;
      robotKutu.classList.add('tkk-tasiniyor');
      durum.konum = { x: e.clientX - surukle.dx, y: e.clientY - surukle.dy };
      yerlestir();
    });
    tuval.addEventListener('pointerup', () => {
      const s = surukle; surukle = null;
      robotKutu.classList.remove('tkk-tasiniyor');
      if (!s) return;
      if (s.oynadi) { durum.konum = robotKonumu(); kaydet(); } else degistir();
    });
    tuval.addEventListener('dblclick', () => { durum.konum = null; kaydet(); yerlestir(); });
    tuval.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); degistir(); } });

    // ---------------------------------------------------------------- mesajlar
    const bekle = (ms: number) => new Promise((r) => setTimeout(r, azHareket ? 0 : ms));
    const asagi = () => { akis.scrollTop = akis.scrollHeight; };

    const mesajCiz = (m: Mesaj): HTMLElement => {
      const p = document.createElement('div');
      p.className = m.kim === 'kodi' ? 'tkk-kodi-sozu' : 'tkk-senin-sozun';
      const yazi = document.createElement('div');
      yazi.className = 'tkk-metin';
      yazi.textContent = m.metin;
      p.appendChild(yazi);
      if (m.kod) {
        const pre = document.createElement('pre');
        pre.className = 'tkk-kod';
        const code = document.createElement('code');
        code.textContent = m.kod;
        const kopya = document.createElement('button');
        kopya.type = 'button'; kopya.className = 'tkk-kopya'; kopya.textContent = 'Kopyala';
        kopya.addEventListener('click', async () => {
          try { await navigator.clipboard.writeText(m.kod!); kopya.textContent = 'Kopyalandı!'; }
          catch { kopya.textContent = 'Kopyalanamadı'; }
          setTimeout(() => (kopya.textContent = 'Kopyala'), 1600);
        });
        // Çalıştır: kod gerçek TürKod çeviricisiyle (Canlı Demo'nun motoru) burada çalışır
        const calistirD = document.createElement('button');
        calistirD.type = 'button'; calistirD.className = 'tkk-calistir'; calistirD.textContent = '▶ Çalıştır';
        calistirD.title = "Bu kodu gerçek TürKod çeviricisiyle burada çalıştır";
        const cikti = document.createElement('div');
        cikti.className = 'tkk-cikti'; cikti.hidden = true;
        cikti.setAttribute('aria-live', 'polite');
        calistirD.addEventListener('click', () => kodCalistir(m.kod!, cikti, calistirD));
        const dugmeler = document.createElement('div');
        dugmeler.className = 'tkk-kod-dugmeler';
        dugmeler.append(calistirD, kopya);
        pre.append(code, dugmeler);
        p.append(pre, cikti);
      }
      if (m.linkler?.length) {
        const sat = document.createElement('div');
        sat.className = 'tkk-linkler';
        for (const l of m.linkler) {
          const a = document.createElement('a');
          a.href = l.u; a.textContent = l.t;
          if (l.u.startsWith('http')) { a.target = '_blank'; a.rel = 'noopener'; }
          sat.appendChild(a);
        }
        p.appendChild(sat);
      }
      // "Vikipedi'de arayayım mı?" sorusunun düğmeleri (cevaplanınca kaybolur).
      if (m.vikiSoru && !m.vikiSoru.cevap) {
        const sat = document.createElement('div');
        sat.className = 'tkk-secenekler';
        for (const [yazi, cevap] of [['Evet, ara', 'evet'], ['Hayır', 'hayir']] as const) {
          const b = document.createElement('button');
          b.type = 'button';
          b.textContent = yazi;
          if (cevap === 'evet') b.className = 'tkk-evet';
          b.addEventListener('click', () => vikiCevapla(m, cevap));
          sat.appendChild(b);
        }
        p.appendChild(sat);
      }
      return p;
    };

    const hazirSorular = () => {
      const sat = document.createElement('div');
      sat.className = 'tkk-hazir';
      for (const s of HAZIR_SORULAR) {
        const b = document.createElement('button');
        b.type = 'button';
        b.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 2H4a2 2 0 0 0-2 2v18l4-4h14a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2Zm0 14H5.17L4 17.17V4h16v12Z" fill="currentColor"/></svg>';
        b.append(s);
        b.addEventListener('click', () => sor(s));
        sat.appendChild(b);
      }
      akis.appendChild(sat);
    };

    /** Bütün sohbeti durumdan, animasyonsuz yeniden çizer (sayfa değişince). */
    const hepsiniCiz = () => {
      akis.innerHTML = '';
      for (const m of durum.mesajlar) akis.appendChild(mesajCiz(m));
      if (!durum.soruldu && durum.mesajlar.length) hazirSorular();
    };

    /** Kodi'nin yeni sözü: önce duruma yazılır (sayfa değişse de kaybolmaz), sonra harf harf görünür. */
    const kodiSoyler = async (c: KodiCevap & { vikiSoru?: Mesaj['vikiSoru'] }) => {
      const m: Mesaj = { kim: 'kodi', metin: c.metin, kod: c.kod, linkler: c.linkler, vikiSoru: c.vikiSoru };
      durum.mesajlar.push(m); kaydet();
      const p = mesajCiz(m);
      const yazi = p.querySelector<HTMLElement>('.tkk-metin')!;
      // Yazma bitince görünecek ekler (zaten gizli olan çalıştırma çıktısı gizli kalır)
      const ekler = ([...p.children].slice(1) as HTMLElement[]).filter((e) => !e.hidden);
      ekler.forEach((e) => (e.hidden = true));
      akis.appendChild(p);
      ifade = 'konusuyor';
      // Harf harf yazma: saniyede ~120 harf (eskisiyle aynı hız), ama ekran saniyede 30 kez güncellenir.
      const harfler = Array.from(c.metin);
      const baslangic = performance.now();
      let gosterilen = -1;
      while (!azHareket) {
        const i = Math.min(harfler.length, Math.floor((performance.now() - baslangic) * 0.12));
        if (i !== gosterilen) {
          yazi.textContent = harfler.slice(0, i).join('') + '▍';
          if (Math.floor(i / 16) !== Math.floor(gosterilen / 16)) asagi();
          gosterilen = i;
        }
        if (i >= harfler.length) break;
        await bekle(33);
      }
      yazi.textContent = c.metin;
      ekler.forEach((e) => (e.hidden = false));
      ifade = 'mutlu';
      asagi();
    };

    const dusunuyor = () => {
      const p = document.createElement('div');
      p.className = 'tkk-dusunuyor';
      p.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 21h-1l1-7H7.5c-.88 0-.33-.75-.31-.78C8.48 10.94 10.42 7.54 13.01 3h1l-1 7h3.51c.4 0 .62.19.4.66C12.97 17.55 11 21 11 21Z" fill="currentColor"/></svg><span></span>';
      const yazi = p.querySelector('span')!;
      akis.appendChild(p); asagi();
      ifade = 'dusunceli';
      const metin = 'Hemen bakıyorum';
      let i = 0;
      const z = setInterval(() => {
        i++;
        yazi.textContent = i <= metin.length ? metin.slice(0, i) : metin + '.'.repeat(1 + (Math.floor((i - metin.length) / 6) % 3));
      }, 60);
      return () => { clearInterval(z); p.remove(); ifade = 'mutlu'; };
    };

    // ---------------------------------------------------------------- kodu çalıştır
    // Kodi'nin gösterdiği kod, Canlı Demo'nun işçisiyle (Pyodide + programdaki TürKod çeviricisi) çalışır:
    // sayfa donmaz, sonsuz döngü 10 saniyede durdurulur, girdi_al için kutunun altında bir giriş açılır.
    const SURE_SINIRI = 10000;
    let isci: Worker | null = null;
    let aktif: { durdur: (neden?: string) => void } | null = null;
    const isciKapat = () => { isci?.terminate(); isci = null; };

    const kodCalistir = (kod: string, cikti: HTMLElement, dugme: HTMLButtonElement) => {
      if (aktif) {
        const ayniDugme = !!dugme.dataset.calisiyor;
        aktif.durdur('Durduruldu.');
        if (ayniDugme) return;                            // çalışan kodun düğmesi: yalnızca durdur
      }
      cikti.hidden = false;
      cikti.innerHTML = '';
      const yazi = document.createElement('pre');
      yazi.className = 'tkk-cikti-yazi';
      const durumSatiri = document.createElement('div');
      durumSatiri.className = 'tkk-cikti-durum';
      durumSatiri.textContent = 'TürKod hazırlanıyor…';
      cikti.append(yazi, durumSatiri);
      dugme.dataset.calisiyor = '1';
      dugme.textContent = '■ Durdur';
      const girdiler: string[] = [];
      const tohum = Math.floor(Math.random() * 1e6);
      let yazilan = 0, gosterilen = 0;
      let zaman: ReturnType<typeof setTimeout> | null = null;
      const zamanDurdur = () => { if (zaman) clearTimeout(zaman); zaman = null; };
      const bitir = (metin: string, tur: 'tamam' | 'uyari' = 'tamam') => {
        zamanDurdur();
        durumSatiri.textContent = metin;
        durumSatiri.dataset.tur = tur;
        delete dugme.dataset.calisiyor;
        dugme.textContent = '▶ Yeniden çalıştır';
        cikti.querySelector('.tkk-girdi')?.remove();
        if (aktif === kontrol) aktif = null;
        asagi();
      };
      const kontrol = { durdur: (neden = 'Durduruldu.') => { isciKapat(); bitir(neden, 'uyari'); } };
      aktif = kontrol;

      const w = (isci ??= new Worker('/demo/demo-isci.js'));
      w.onmessage = (e: MessageEvent) => {
        if (aktif !== kontrol) return;
        const m = e.data;
        if (m.tur === 'durum') durumSatiri.textContent = m.metin;
        else if (m.tur === 'hazir') {
          durumSatiri.textContent = 'Çalışıyor…';
          zamanDurdur();
          zaman = setTimeout(() => kontrol.durdur('Kod 10 saniyede bitmedi ve durduruldu (sonsuz döngü olabilir).'), SURE_SINIRI);
        } else if (m.tur === 'yaz') {
          // girdi_al sonrası program baştan çalışır: daha önce gösterilen kısım atlanır
          const metin: string = m.metin;
          const bas = Math.max(0, gosterilen - yazilan);
          yazilan += metin.length;
          if (bas < metin.length) { yazi.textContent += metin.slice(bas); gosterilen = yazilan; asagi(); }
        } else if (m.tur === 'girdi') {
          zamanDurdur();
          durumSatiri.textContent = 'Kod senden bir girdi bekliyor:';
          const f = document.createElement('form');
          f.className = 'tkk-girdi';
          const g = document.createElement('input');
          g.type = 'text'; g.placeholder = 'Yaz ve Enter\'a bas'; g.setAttribute('aria-label', m.istem || 'Girdi');
          f.append(g);
          f.addEventListener('submit', (ev) => {
            ev.preventDefault();
            const deger = g.value;
            girdiler.push(deger);
            yazi.textContent += deger + '\n';
            gosterilen += deger.length + 1;
            f.remove();
            durumSatiri.textContent = 'Çalışıyor…';
            yazilan = 0;
            w.postMessage({ tur: 'calistir', kod, girdiler, tohum });
          });
          cikti.append(f);
          asagi();
          g.focus();
        } else if (m.tur === 'bitti') {
          if (!yazi.textContent) yazi.textContent = '(Kod bir şey yazdırmadı.)';
          bitir(m.kod === 0 ? '✓ Tamamlandı (gerçek TürKod çeviricisiyle çalıştı).' : `Kod ${m.kod} koduyla sonlandı.`, m.kod === 0 ? 'tamam' : 'uyari');
        } else if (m.tur === 'hata') {
          isciKapat();
          bitir('Çalıştırılamadı: ' + m.metin + ' İnternet bağlantını kontrol edip yeniden dene.', 'uyari');
        }
      };
      w.onerror = () => { isciKapat(); bitir('Çalıştırıcı başlatılamadı. Sayfayı yenileyip yeniden dene.', 'uyari'); };
      w.postMessage({ tur: 'calistir', kod, girdiler, tohum });
      asagi();
    };

    // ---------------------------------------------------------------- cevap bulma
    let pagefind: any = null;
    const ara = async (soru: string): Promise<Baglanti[]> => {
      try {
        if (!pagefind) {
          const yol = '/pagefind/pagefind.js';
          pagefind = await import(/* @vite-ignore */ yol);
          await pagefind.options?.({ excerptLength: 12 });
        }
        // Dizin bütün sözcüklerin geçtiği sayfaları bulur: dolgu sözcükler atılır, sonuç yoksa sorgu kısaltılır.
        const sozcukler = soru.toLocaleLowerCase('tr-TR').replace(/[^\p{L}\p{N}_ ]/gu, ' ').split(/\s+/)
          .filter((w) => w.length > 1 && !DOLGU.has(sadelestir(w)));
        const denemeler = [soru, sozcukler.join(' ')];
        for (let n = sozcukler.length - 1; n >= 2; n--) denemeler.push(sozcukler.slice(0, n).join(' '));
        denemeler.push(...[...sozcukler].sort((a, b) => b.length - a.length));
        for (const d of [...new Set(denemeler)].filter(Boolean)) {
          const r = await pagefind.search(d);
          if (!r?.results?.length) continue;
          const veri = await Promise.all(r.results.slice(0, 6).map((x: any) => x.data()));
          // Yalnızca soruyla gerçekten örtüşen (en az 4 harf ortak başlangıçlı) sonuçlar kalır.
          const aranan = d.split(/\s+/).map(sadelestir).filter(Boolean);
          const uygun = veri.filter((v: any) =>
            [...String(v.excerpt || '').matchAll(/<mark>(.*?)<\/mark>/g)].some((m) => {
              const x = sadelestir(m[1]);
              return x.length >= 3 && aranan.some((w) => {
                let n = 0; while (n < x.length && n < w.length && x[n] === w[n]) n++;
                return n >= Math.min(w.length, 4);
              });
            }));
          if (!uygun.length) continue;
          return uygun.slice(0, 3).map((v: any) => ({ t: v.meta?.title || v.url, u: v.url }));
        }
        return [];
      } catch {
        return [];
      }
    };

    // ---------------------------------------------------------------- Vikipedi (isteğe bağlı)
    // Yalnızca düğme açıkken ve kullanıcı her seferinde "Evet" derse aranır. Ücretsiz, anahtarsız
    // Vikipedi servisi kullanılır; soru Vikipedi'ye gönderilir (düğmenin açıklamasında yazar).
    const VIKI = 'https://tr.wikipedia.org';
    // Vikipedi araması soru değil anahtar sözcük ister: bu soru sözcükleri de atılır.
    const SORU_SOZCUKLERI = new Set(['neresi', 'nerede', 'kimdir', 'kim', 'kimin', 'hangisi', 'nelerdir', 'calisir', 'calisiyor',
      'yapar', 'yapilir', 'olan', 'olur', 'mudur', 'midir', 'nedir', 'ne', 'nasil', 'kac', 'tane', 'hakkinda', 'bilgi', 'ver', 'anlatir', 'misin']);
    type VikiCevap = KodiCevap & { baslik?: string };
    // "Türkiye'nin başkenti neresi" -> ["Türkiye", "başkenti"]: kesmeden sonraki ek, dolgu ve soru sözcükleri atılır.
    const aramaSozcukleri = (soru: string) => soru.replace(/['’][\p{L}]+/gu, '').replace(/[^\p{L}\p{N}\s-]/gu, ' ').split(/\s+/)
      .filter((w) => w.length > 1 && !DOLGU.has(sadelestir(w)) && !SORU_SOZCUKLERI.has(sadelestir(w))
        && !['bu', 'bunu', 'bunun', 'o', 'onu', 'onun', 'orasi', 'oranin'].includes(sadelestir(w))).slice(0, 4);
    const VIKI_NOT = "\n\n(Bu bilgi Vikipedi'den; benim hazır bilgim değil.)";
    const ULASILAMADI: VikiCevap = { metin: "Vikipedi'ye şu an ulaşamadım. İnternet bağlantını kontrol edip biraz sonra yeniden dener misin?" };

    /**
     * Takip sorusu: bilinen bir maddenin TAM metninde, soruyla en çok örtüşen cümle bulunur.
     * "Türkiye" + "peki başkenti nedir" -> "... başkenti Ankara ..." cümlesi.
     */
    const maddedeAra = async (baslik: string, soru: string): Promise<VikiCevap | null> => {
      const sozcukler = aramaSozcukleri(soru);
      if (!sozcukler.length) return null;
      const kok = (w: string) => { const s = sadelestir(w); return s.slice(0, Math.min(5, s.length)); };
      const istenen = [...new Set(sozcukler.map(kok))];
      try {
        const r = await fetch(`${VIKI}/w/api.php?action=query&prop=extracts&explaintext=1&redirects=1&format=json&origin=*&titles=${encodeURIComponent(baslik)}`);
        const sayfa: any = Object.values((await r.json())?.query?.pages ?? {})[0];
        const metin = String(sayfa?.extract ?? '');
        if (!metin) return null;
        // Başlık satırları (== ... ==) atlanır; cümlelere bölünür.
        const cumleler = metin.split('\n').filter((s) => s.trim() && !/^=+.*=+$/.test(s.trim()))
          .flatMap((p) => p.match(/[^.!?]+(?:[.!?]+|$)/g) ?? []).map((c) => c.trim()).filter((c) => c.length > 20);
        let en = -1, enPuan = 0;
        cumleler.forEach((c, i) => {
          const s = sadelestir(c).split(' ');
          const puan = istenen.filter((k) => s.some((w) => w.startsWith(k))).length;
          if (puan > enPuan) { enPuan = puan; en = i; }
        });
        if (en < 0) return null;
        let bulunan = cumleler[en];
        if (bulunan.length < 90 && cumleler[en + 1]) bulunan += ' ' + cumleler[en + 1];
        return {
          metin: `Vikipedi'deki "${sayfa.title}" maddesinde şunu buldum:\n\n${bulunan}${VIKI_NOT}`,
          linkler: [{ t: `Vikipedi: ${sayfa.title}`, u: `${VIKI}/wiki/${encodeURIComponent(String(sayfa.title).replace(/ /g, '_'))}` }],
          baslik: sayfa.title,
        };
      } catch {
        return ULASILAMADI;
      }
    };

    const vikipedideAra = async (soru: string): Promise<VikiCevap | null> => {
      const sozcukler = aramaSozcukleri(soru);
      if (!sozcukler.length) return null;
      // Birkaç sorgu birlikte denenir: tamamı, baştan kısaltılmışları ve tek tek sözcükler.
      const sorgular = [sozcukler.join(' ')];
      for (let n = sozcukler.length - 1; n >= 2; n--) sorgular.push(sozcukler.slice(0, n).join(' '));
      if (sozcukler.length > 1) sorgular.push(...sozcukler);
      const kok = (w: string) => sadelestir(w).slice(0, Math.min(5, sadelestir(w).length));
      const istenen = sozcukler.map(kok);
      try {
        const listeler = await Promise.all([...new Set(sorgular)].map(async (q) => {
          const a = await fetch(`${VIKI}/w/api.php?action=query&list=search&format=json&origin=*&srlimit=5&srsearch=${encodeURIComponent(q)}`);
          return ((await a.json())?.query?.search ?? []) as { title: string }[];
        }));
        // Aday puanı: başlıkta geçen soru sözcüğü sayısı (çok iyi), arama sırası ve başlığın kısalığı.
        const adaylar = new Map<string, { eslesen: number; sira: number; uzunluk: number }>();
        for (const liste of listeler) liste.forEach((s, sira) => {
          const baslik = sadelestir(s.title).split(' ');
          const eslesen = istenen.filter((k) => baslik.some((b) => b.startsWith(k))).length;
          const onceki = adaylar.get(s.title);
          if (!onceki || sira < onceki.sira) adaylar.set(s.title, { eslesen, sira, uzunluk: baslik.length });
        });
        const sirali = [...adaylar.entries()]
          .sort(([, a], [, b]) => b.eslesen - a.eslesen || a.sira - b.sira || a.uzunluk - b.uzunluk)
          .filter(([, a]) => a.eslesen > 0);
        for (const [baslik] of sirali.slice(0, 5)) {
          const r = await fetch(`${VIKI}/api/rest_v1/page/summary/${encodeURIComponent(baslik.replace(/ /g, '_'))}`);
          if (!r.ok) continue;
          const o = await r.json();
          if (o.type === 'disambiguation' || !o.extract) continue;  // anlam ayrımı sayfaları atlanır
          // En fazla 3 cümle / 420 harf
          const cumleler = String(o.extract).match(/[^.!?]+[.!?]+(\s|$)/g) ?? [String(o.extract)];
          let ozet = '';
          for (const c of cumleler) { if ((ozet + c).length > 420 && ozet) break; ozet += c; }
          return {
            metin: `Vikipedi'de "${o.title}" maddesini buldum:\n\n${ozet.trim()}${VIKI_NOT}`,
            linkler: [{ t: `Vikipedi: ${o.title}`, u: o.content_urls?.desktop?.page ?? `${VIKI}/wiki/${encodeURIComponent(o.title)}` }],
            baslik: o.title,
          };
        }
        return null;
      } catch {
        return ULASILAMADI;
      }
    };

    const vikiAramasiYap = async (soru: string, baslik?: string) => {
      mesgul = true;
      giris.placeholder = 'Kodi Vikipedi\'de arıyor…';
      balon.dataset.bekliyor = '1';
      const bitir = dusunuyor();
      // Takip sorusu: önce bilinen maddenin içinde; bulunamazsa "madde + soru" ile genel arama.
      const aramaYap = async () => (baslik ? (await maddedeAra(baslik, soru)) ?? (await vikipedideAra(`${baslik} ${soru}`)) : vikipedideAra(soru));
      const [sonuc] = await Promise.all([aramaYap(), bekle(500)]);
      bitir();
      if (sonuc?.baslik) { durum.konu = { tur: 'viki', baslik: sonuc.baslik, soru }; kaydet(); }
      await kodiSoyler(sonuc ?? { metin: "Vikipedi'de de buna uygun bir madde bulamadım. Sorunu başka kelimelerle yazmayı dener misin?" });
      giris.placeholder = "Kodi'ye bir şey sor…";
      delete balon.dataset.bekliyor;
      mesgul = false;
    };

    const vikiCevapla = (m: Mesaj, cevap: 'evet' | 'hayir') => {
      if (mesgul || !m.vikiSoru || m.vikiSoru.cevap) return;
      m.vikiSoru.cevap = cevap;
      const yanit: Mesaj = cevap === 'evet'
        ? { kim: 'sen', metin: 'Evet, ara', vikiAra: m.vikiSoru.soru, vikiBaslik: m.vikiSoru.baslik }
        : { kim: 'sen', metin: 'Hayır' };
      durum.mesajlar.push(yanit); kaydet();
      akis.querySelectorAll('.tkk-secenekler').forEach((e) => e.remove());
      akis.appendChild(mesajCiz(yanit)); asagi();
      if (cevap === 'evet') vikiAramasiYap(m.vikiSoru.soru, m.vikiSoru.baslik);
      else kodiSoyler({ metin: 'Peki, aramıyorum. Başka bir şey sormak istersen buradayım!' });
    };

    const cevapla = async (soru: string) => {
      mesgul = true;
      giris.placeholder = 'Kodi cevaplıyor…';
      balon.dataset.bekliyor = '1';
      const bitir = dusunuyor();
      const [dizin, bdz, { BILGI }, { hesapCevabi, hesapSorusuGibi }] = await Promise.all([sozlukAl(), bolumAl(), bilgiAl(), hesapAl(), bekle(600)]);
      // Matematik: Kodi soruyu TürKod koduna çevirip arkada çalıştırır (değişken adları sözlükteki kelimelerle çakışmaz)
      let hesap = null;
      try { hesap = hesapCevabi(soru, durum.hesap, (ad) => !!dizin?.tr.has(katla(ad))); } catch { hesap = null; }
      if (hesap) {
        durum.hesap = hesap.baglam; durum.konu = null; kaydet();
        bitir();
        await kodiSoyler({ metin: hesap.metin, kod: hesap.kod });
        giris.placeholder = "Kodi'ye bir şey sor…";
        delete balon.dataset.bekliyor;
        mesgul = false;
        return;
      }
      durum.hesap = null;
      const konu = durum.konu;
      const t = takipMi(soru);
      const yerel = hesapSorusuGibi(soru) ? null : baglamliCevap(soru, konu?.tur === 'bilgi' ? { soru: konu.soru, id: konu.id } : null, BILGI, dizin, bdz);
      let cevap: (KodiCevap & { vikiSoru?: Mesaj['vikiSoru'] }) | null = yerel;
      if (!yerel && hesapSorusuGibi(soru)) {
        cevap = {
          metin: 'Bunu bir hesap sorusu olarak anladım ama tam çözemedim. İşlemi açıkça yazarsan hemen hesaplarım, örneğin:\n'
            + '• 12 * 7 + 5  • 144\'ün karekökü  • 3x + 5 = 20\n'
            + "Sözel problemlerde her bilgiyi ayrı bir cümleyle yazmak da işime yarar: \"Ali'nin 5 elması var. 3 tane daha aldı. Kaç elması oldu?\"",
        };
      }
      if (yerel) {
        // Bağlamdan gelen cevapta konu aynı kalır ("liste" -> "peki sırala" -> "ya ters?" hep listeyle ilgili).
        durum.konu = { tur: 'bilgi', soru: yerel.baglamdan && konu?.tur === 'bilgi' ? konu.soru : soru, id: yerel.id };
        kaydet();
      }
      // Önceki konu bir Vikipedi maddesiyse ve soru onun devamıysa ("Peki başkenti nedir") o maddede aranır.
      if (konu?.tur === 'viki' && t.takip && (!yerel || t.gonderme)) {
        cevap = durum.internet
          ? {
              metin: `Bunu az önceki "${konu.baslik}" maddesinde arayayım mı? (Sorun Vikipedi'ye gönderilir.)`,
              vikiSoru: { soru, baslik: konu.baslik },
            }
          : {
              metin: `Az önce Vikipedi'deki "${konu.baslik}" maddesine bakmıştık. Orada aramam için yukarıdaki dünya düğmesiyle internette aramayı açman gerekiyor.`,
            };
      }
      if (!cevap) {
        const sonuclar = await ara(soru);
        if (durum.internet) {
          // İnternet açık: aramadan önce her seferinde izin istenir.
          cevap = {
            metin: (sonuclar.length
              ? 'Hazır bilgilerimde yok ama sitede şu sayfalar ilgili olabilir.'
              : 'Bunu hazır bilgilerimde ve sitede bulamadım.')
              + " Vikipedi'de arayayım mı? (Sorun Vikipedi'ye gönderilir.)",
            linkler: sonuclar.length ? sonuclar : undefined,
            vikiSoru: { soru },
          };
        } else if (sonuclar.length) {
          cevap = { metin: 'Bunu sitede şu sayfalarda buldum, bir bakar mısın?', linkler: sonuclar };
        }
      }
      bitir();
      await kodiSoyler(cevap ?? {
        metin: 'Hmm, bunu tam anlayamadım. Sorunu biraz farklı yazar mısın? Örneğin "liste nedir?" ya da "yazdır ne demek?" diye sorabilirsin. '
          + "İstersen yukarıdaki dünya düğmesiyle internette (Vikipedi'de) aramayı da açabilirsin.",
        linkler: [{ t: 'Sorun Giderme ve SSS', u: '/use/troubleshooting/' }, { t: "GitHub'da sor", u: `${GITHUB}/issues/new/choose` }],
      });
      giris.placeholder = "Kodi'ye bir şey sor…";
      delete balon.dataset.bekliyor;
      mesgul = false;
    };

    const sor = (soru: string) => {
      if (mesgul) return;
      akis.querySelector('.tkk-hazir')?.remove();
      // Yeni soru sorulunca cevaplanmamış "Vikipedi'de arayayım mı?" sorusu kapanır.
      for (const x of durum.mesajlar) if (x.vikiSoru && !x.vikiSoru.cevap) x.vikiSoru.cevap = 'hayir';
      akis.querySelectorAll('.tkk-secenekler').forEach((e) => e.remove());
      durum.soruldu = true;
      const m: Mesaj = { kim: 'sen', metin: soru };
      durum.mesajlar.push(m); kaydet();
      akis.appendChild(mesajCiz(m)); asagi();
      cevapla(soru);
    };

    const selamla = async () => {
      durum.mesajlar = []; durum.soruldu = false; durum.konu = null; durum.hesap = null; kaydet();
      aktif?.durdur();
      akis.innerHTML = '';
      elSalla();
      await kodiSoyler({ metin: SELAM });
      if (!durum.soruldu) { hazirSorular(); asagi(); }
    };

    // ---------------------------------------------------------------- aç / kapat
    const ac = (ilkYukleme = false) => {
      balon.hidden = false; ipucu.hidden = true;
      // İlk soru beklemesin: bilgi tabanı ve hesap motoru şimdiden indirilmeye başlar
      void bilgiAl(); void hesapAl();
      if (ilkYukleme) balon.classList.add('tkk-sessiz');
      tuval.setAttribute('aria-expanded', 'true');
      durum.acik = true; kaydet();
      yerlestir();
      if (!durum.mesajlar.length) selamla();
      if (!ilkYukleme) setTimeout(() => giris.focus(), 50);
    };
    const kapat = () => {
      balon.hidden = true; balon.classList.remove('tkk-sessiz');
      tuval.setAttribute('aria-expanded', 'false');
      durum.acik = false; kaydet();
    };
    const degistir = () => (balon.hidden ? ac() : kapat());

    // İnternet (Vikipedi) düğmesi: varsayılan kapalı; oturum boyunca hatırlanır.
    const internetDugme = balon.querySelector<HTMLButtonElement>('[data-kodi-internet]')!;
    const internetGoster = () => {
      internetDugme.setAttribute('aria-pressed', String(durum.internet));
      internetDugme.title = durum.internet
        ? "İnternette arama açık: Kodi bulamadığı soruları Vikipedi'de aramayı önerir, aramadan önce sana sorar. Kapatmak için tıkla."
        : "İnternette arama kapalı. Açarsan Kodi bulamadığı soruları Vikipedi'de aramayı önerir (her seferinde sorar).";
    };
    internetGoster();
    internetDugme.addEventListener('click', () => {
      if (mesgul) return;
      durum.internet = !durum.internet; kaydet(); internetGoster();
      kodiSoyler({
        metin: durum.internet
          ? "İnternette arama açık! Hazır bilgilerimde bir şey bulamazsam Vikipedi'de aramayı önereceğim, ama aramadan önce hep sana soracağım."
          : 'İnternette arama kapandı. Artık yalnızca kendi bilgilerimle ve bu sitede arayarak cevap vereceğim.',
      });
    });

    balon.querySelector('[data-kodi-kapat]')!.addEventListener('click', kapat);
    balon.querySelector('[data-kodi-yeni]')!.addEventListener('click', () => { if (!mesgul) selamla(); });
    ipucu.addEventListener('click', () => ac());
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !balon.hidden) kapat(); });
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const s = giris.value.trim();
      if (!s || mesgul) return;
      giris.value = ''; durum.taslak = ''; kaydet();
      sor(s);
    });
    giris.addEventListener('input', () => { durum.taslak = giris.value; });
    akis.addEventListener('scroll', () => { durum.kaydirma = akis.scrollTop; });
    // Sayfadan ayrılırken taslak ve kaydırma yeri de saklanır.
    window.addEventListener('pagehide', kaydet);

    // ---------------------------------------------------------------- önceki sayfadan devam
    yerlestir();
    hepsiniCiz();
    giris.value = durum.taslak || '';
    if (durum.acik) {
      ac(true);
      akis.scrollTop = durum.kaydirma || akis.scrollHeight;
      // Soru sorulup cevap gelmeden sayfa değiştiyse cevap burada tamamlanır.
      const son = durum.mesajlar[durum.mesajlar.length - 1];
      if (son?.kim === 'sen') {
        if (son.vikiAra) vikiAramasiYap(son.vikiAra, son.vikiBaslik);
        else if (son.metin !== 'Hayır') cevapla(son.metin);
      }
    }

    // İlk ziyarette birkaç saniye sonra küçük bir selam (oturumda bir kez).
    if (!durum.ipucu && !durum.acik) {
      setTimeout(() => {
        if (!balon.hidden || durum.ipucu) return;
        durum.ipucu = true; kaydet();
        ipucu.hidden = false; elSalla();
        setTimeout(() => { ipucu.hidden = true; }, 7000);
      }, 6000);
    }
  }
</script>

