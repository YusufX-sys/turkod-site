---
// Ekran görüntüsü + isteğe bağlı açıklama. Görsel Astro tarafından optimize edilir.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="tk-figure">
  <a href={src.src} target="_blank" rel="noopener" title="Büyütmek için tıkla">
    <Image class="tk-shot" src={src} alt={alt} loading="lazy" />
  </a>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
