<script>
  (async () => {
    const FALLBACK_URL = '/turkod-site/releases/';
    const REPO = 'YusufX-sys/turkod-ide';

    const winIconSvg = `<svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
      <rect x="2" y="2" width="9" height="9"/>
      <rect x="13" y="2" width="9" height="9"/>
      <rect x="2" y="13" width="9" height="9"/>
      <rect x="13" y="13" width="9" height="9"/>
    </svg>`;

    function insertButton(href) {
      const heroActions = document.querySelector('.hero .actions');
      if (!heroActions || !heroActions.parentElement) return;
      if (document.querySelector('.tk-win-download')) return; // zaten eklenmiş

      const btn = document.createElement('a');
      btn.href = href;
      btn.className = 'tk-win-download';
      btn.rel = 'noopener';
      btn.innerHTML = winIconSvg + '<span>Windows İçin İndir</span>';
      heroActions.parentElement.insertBefore(btn, heroActions);
    }

    try {
      const res = await fetch(`https://api.github.com/repos/${REPO}/releases/latest`);
      if (!res.ok) throw new Error('GitHub API isteği başarısız: ' + res.status);
      const data = await res.json();
      const asset = (data.assets || []).find(a => a.name.toLowerCase().endsWith('.zip'));
      insertButton(asset ? asset.browser_download_url : FALLBACK_URL);
    } catch (err) {
      console.warn('TürKod: en güncel sürüm bilgisi alınamadı, sürümler sayfasına yönlendiriliyor.', err);
      insertButton(FALLBACK_URL);
    }
  })();
</script>

<style is:global>
  .tk-win-download {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    width: fit-content;
    margin: 0 0 20px;
    padding: 18px 36px;
    border-radius: 999px;
    background: linear-gradient(90deg, #0078d4, #00b7ff, #50e6ff);
    background-size: 200% auto;
    color: #fff !important;
    font-weight: 700;
    font-size: 18px;
    text-decoration: none !important;
    box-shadow: 0 0 28px rgba(0, 120, 212, .6);
    transition: background-position .4s, transform .2s, box-shadow .2s;
  }
  .tk-win-download:hover {
    background-position: 200% center;
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 0 40px rgba(0, 183, 255, .75);
  }
  .tk-win-download svg {
    width: 24px;
    height: 24px;
    flex: none;
  }
</style>