---
// Canlı Demo: TürKod kodunu tarayıcıda, programın GERÇEK çeviricisiyle çalıştırır.
// Python (Pyodide) bir Web Worker'da çalışır (public/demo/demo-isci.js); çevirici paketi
// public/demo/turkod_ide.zip (scripts/demo-paket-uret.py ile üretilir). Hata mesajları
// programdaki terminaldekiyle aynıdır.
---
<div class="tk-demo">
  <div class="tk-pane">
    <div class="tk-bar"><span class="tk-d r"></span><span class="tk-d y"></span><span class="tk-d g"></span><span class="tk-t">kod-editörü</span></div>
    <textarea id="tk-code" spellcheck="false">isim = girdi_al("Adın ne? ")
yazdır("Merhaba " + isim)

için i içinde aralık(1, 4):
    yazdır(i, ". tur")

yas = 15
eğer yas >= 18:
    yazdır("Reşitsin")
değilse:
    yazdır("Reşit değilsin")</textarea>
    <div class="tk-row">
      <button id="tk-run">▶ Çalıştır</button>
      <button id="tk-stop" class="tk-ghost" disabled>■ Durdur</button>
      <button id="tk-clear" class="tk-ghost">Temizle</button>
    </div>
  </div>
  <div class="tk-pane">
    <div class="tk-bar"><span class="tk-d r"></span><span class="tk-d y"></span><span class="tk-d g"></span><span class="tk-t">terminal</span></div>
    <div id="tk-out"><div class="tk-line dim">TürKod Demo - Hazır</div><div id="tk-cursor" class="tk-cursor"></div></div>
  </div>
</div>
<p class="tk-note">
  Demo, TürKod programının <strong>gerçek çeviricisiyle</strong> çalışır: döngüler, fonksiyonlar, sınıflar, listeler,
  sözlükler, <code>matematik</code>, <code>rastgele</code>, <code>tarih_saat</code> gibi kütüphaneler ve Türkçe hata mesajları
  programdaki gibidir. <code>girdi_al</code> girdiyi sağdaki terminalden ister. İlk çalıştırmada tarayıcıya Python
  yüklendiği için birkaç saniye beklenir. Pencere açan kütüphaneler (<code>kaplumbağa</code>, <code>py_oyun</code>,
  <code>pencere</code>) yalnızca programda çalışır: <a href="/releases/">tam sürümü indir</a>.
</p>

<script>
  const kodKutusu = document.getElementById('tk-code') as HTMLTextAreaElement;
  const cikti = document.getElementById('tk-out')!;
  const imlec = document.getElementById('tk-cursor')!;
  const calistirDugme = document.getElementById('tk-run') as HTMLButtonElement;
  const durdurDugme = document.getElementById('tk-stop') as HTMLButtonElement;
  const SURE_SINIRI = 10_000; // ms: girdi beklerken sayılmaz

  let isci: Worker | null = null;
  let girdiler: string[] = [];
  let tohum = 0;
  let gosterilen = 0;   // bu programda ekrana yazılmış karakter sayısı
  let yazilan = 0;      // bu çalıştırmada üretilen karakter sayısı (yeniden çalıştırmada eskisi atlanır)
  let zamanlayici: ReturnType<typeof setTimeout> | null = null;
  let satir: HTMLDivElement | null = null;

  // ------------------------------------------------------------------ terminal
  const HATA_SATIRI = /^(\[HATA\]|Satır Numarası:|Açıklama:|Dosya:|Bunu mu demek|İpucu:|={10,}$|  Satır \d+)/;
  const sistemSatiri = (metin: string, sinif: string) => {
    satiriBitir();
    const d = document.createElement('div');
    d.className = 'tk-line ' + sinif;
    d.textContent = metin;
    cikti.insertBefore(d, imlec);
    cikti.scrollTop = cikti.scrollHeight;
  };
  const satiriBitir = () => {
    if (satir && HATA_SATIRI.test(satir.textContent || '')) satir.classList.add('warn');
    satir = null;
  };
  const ekle = (metin: string) => {
    const parcalar = metin.split('\n');
    parcalar.forEach((p, i) => {
      if (i > 0) satiriBitir();
      if (!satir) {
        if (!p && i < parcalar.length - 1) {
          // boş satır
          const d = document.createElement('div');
          d.className = 'tk-line';
          d.innerHTML = '&nbsp;';
          cikti.insertBefore(d, imlec);
          return;
        }
        if (!p) return;
        satir = document.createElement('div');
        satir.className = 'tk-line';
        cikti.insertBefore(satir, imlec);
      }
      satir.textContent += p;
    });
    cikti.scrollTop = cikti.scrollHeight;
  };
  const temizle = () => { cikti.innerHTML = ''; cikti.appendChild(imlec); satir = null; };

  // ------------------------------------------------------------------ çalıştırma
  const durumlar = (calisiyor: boolean) => {
    calistirDugme.disabled = calisiyor;
    durdurDugme.disabled = !calisiyor;
  };
  const zamanlayiciDurdur = () => { if (zamanlayici) clearTimeout(zamanlayici); zamanlayici = null; };
  const isciyiKapat = () => { zamanlayiciDurdur(); isci?.terminate(); isci = null; };

  const isciAl = () => {
    if (isci) return isci;
    isci = new Worker('/demo/demo-isci.js');
    isci.onmessage = (e: MessageEvent) => {
      const m = e.data;
      if (m.tur === 'durum') { if (calistirDugme.disabled) sistemSatiri(m.metin, 'dim'); }
      else if (m.tur === 'hazir') {
        zamanlayiciDurdur();
        zamanlayici = setTimeout(() => {
          isciyiKapat();
          sistemSatiri('turkod> Program 10 saniyede bitmedi ve durduruldu (sonsuz döngü olabilir).', 'warn');
          durumlar(false);
        }, SURE_SINIRI);
      } else if (m.tur === 'yaz') {
        // Yeniden çalıştırmada daha önce gösterilen kısım atlanır.
        const metin: string = m.metin;
        const bas = Math.max(0, gosterilen - yazilan);
        yazilan += metin.length;
        if (bas < metin.length) { ekle(metin.slice(bas)); gosterilen = yazilan; }
      } else if (m.tur === 'girdi') {
        zamanlayiciDurdur();
        girdiIste();
      } else if (m.tur === 'bitti') {
        zamanlayiciDurdur();
        satiriBitir();
        sistemSatiri(m.kod === 0 ? 'turkod> tamamlandı.' : `turkod> program ${m.kod} koduyla sonlandı.`, 'dim');
        durumlar(false);
      } else if (m.tur === 'hata') {
        zamanlayiciDurdur();
        sistemSatiri('⚠ Demo çalıştırılamadı: ' + m.metin, 'warn');
        sistemSatiri('İnternet bağlantını kontrol edip yeniden dene ya da tam sürümü indir.', 'dim');
        isciyiKapat();
        durumlar(false);
      }
    };
    isci.onerror = () => {
      sistemSatiri('⚠ Demo başlatılamadı. Sayfayı yenileyip yeniden dene.', 'warn');
      isciyiKapat();
      durumlar(false);
    };
    return isci;
  };

  const baslat = () => {
    yazilan = 0;
    isciAl().postMessage({ tur: 'calistir', kod: kodKutusu.value, girdiler, tohum });
  };

  // girdi_al: girdi terminalden alınır; Enter'a basılınca program bu girdiyle baştan sürer.
  const girdiIste = () => {
    if (!satir) {
      satir = document.createElement('div');
      satir.className = 'tk-line';
      cikti.insertBefore(satir, imlec);
    }
    const kutu = document.createElement('input');
    kutu.className = 'tk-input';
    kutu.spellcheck = false;
    kutu.setAttribute('aria-label', 'Programın istediği girdi');
    satir.classList.add('tk-input-line');
    satir.appendChild(kutu);
    kutu.focus();
    cikti.scrollTop = cikti.scrollHeight;
    kutu.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      e.preventDefault();
      girdiler.push(kutu.value);
      kutu.remove();
      satir?.classList.remove('tk-input-line');
      baslat();
    });
  };

  calistirDugme.addEventListener('click', () => {
    if (!kodKutusu.value.trim()) { temizle(); sistemSatiri('Çalıştırılacak kod yok.', 'warn'); return; }
    temizle();
    sistemSatiri('turkod> çalıştırılıyor...', 'dim');
    girdiler = [];
    tohum = Math.floor(Math.random() * 2 ** 31);
    gosterilen = 0;
    durumlar(true);
    baslat();
  });

  durdurDugme.addEventListener('click', () => {
    isciyiKapat();
    satiriBitir();
    sistemSatiri('turkod> durduruldu.', 'dim');
    durumlar(false);
  });

  document.getElementById('tk-clear')!.addEventListener('click', () => {
    if (!calistirDugme.disabled) { temizle(); kodKutusu.value = ''; kodKutusu.focus(); return; }
    isciyiKapat();
    durumlar(false);
    temizle();
    kodKutusu.value = '';
    kodKutusu.focus();
  });

  // Ctrl+Enter ile çalıştır; Tab girinti ekler (4 boşluk).
  kodKutusu.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) { e.preventDefault(); if (!calistirDugme.disabled) calistirDugme.click(); }
    if (e.key === 'Tab' && !e.shiftKey) {
      e.preventDefault();
      const b = kodKutusu.selectionStart, s = kodKutusu.selectionEnd;
      kodKutusu.setRangeText('    ', b, s, 'end');
    }
  });

  // Sayfa açılınca Python arka planda hazırlanır; ilk çalıştırma beklemez.
  const onYukle = () => { if (!isci) isciAl().postMessage({ tur: 'hazirla' }); };
  if ('requestIdleCallback' in window) (window as any).requestIdleCallback(onYukle, { timeout: 4000 });
  else setTimeout(onYukle, 2500);
</script>
