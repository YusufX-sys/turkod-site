</section>

<section class="tk-l tk-section tk-oss">
  <div class="tk-oss-text">
    <span class="tk-eyebrow">Açık kaynak</span>
    <h2>Herkes için, herkesle birlikte</h2>
    <p>TürKod'un bütün kodu MIT lisansıyla GitHub'da. Hata bildirebilir, sözlüğe yeni bir Türkçe karşılık önerebilir ya da doğrudan kod gönderebilirsin.</p>
    <div class="tk-oss-actions">
      <a class="tk-btn-grad" href={REPO} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z"/></svg>
        GitHub'da incele
      </a>
      <a class="tk-btn-line" href="/contribute/">Katkıda bulun</a>
      <a class="tk-btn-line" href={`${REPO}/issues/new/choose`} target="_blank" rel="noopener">Hata bildir</a>
    </div>
  </div>
  <div class="tk-oss-card">
    <div class="tk-oss-row"><span>Lisans</span><b>MIT</b></div>
    <div class="tk-oss-row"><span>İmza</span><b>RSA-PSS · SHA-256</b></div>
    <div class="tk-oss-row"><span>Platform</span><b>Windows 10 / 11</b></div>
    <div class="tk-oss-row"><span>Teknoloji</span><b>Flutter · Python</b></div>
    <div class="tk-oss-verify">
      <small>Kaynak kodun imzasını kendin doğrula:</small>
      <code>python kaynak_imzala.py --dogrula</code>
    </div>
  </div>
</section>

<section class="tk-l tk-cta">
  <h2>Kodlamaya bugün, kendi dilinde başla.</h2>
  <p>Ücretsiz, reklamsız, kurulumu iki dakika.</p>
  <div class="tk-cta-actions">
    <a class="tk-btn-grad tk-btn-big" href="/releases/" data-tk-download>Windows için indir</a>
    <a class="tk-btn-line tk-btn-big" href="/demo/">Tarayıcıda dene</a>
  </div>
</section>

<script>
  // Sekmeler (klavye ile de gezilebilir)
  document.querySelectorAll<HTMLElement>('[data-tk-tabs]').forEach((kutu) => {
    const sekmeler = Array.from(kutu.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const sec = (i: number) => {
      sekmeler.forEach((s, j) => {
        const secili = i === j;
        s.setAttribute('aria-selected', String(secili));
        s.tabIndex = secili ? 0 : -1;
        const panel = document.getElementById(s.getAttribute('aria-controls') || '');
        if (panel) panel.hidden = !secili;
      });
    };
    sekmeler.forEach((s, i) => {
      s.addEventListener('click', () => sec(i));
      s.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        const y = (i + (e.key === 'ArrowRight' ? 1 : -1) + sekmeler.length) % sekmeler.length;
        sec(y); sekmeler[y].focus();
      });
    });
  });

  // "Windows için indir" düğmesini doğrudan en yeni kurulum dosyasına bağla
  (async () => {
    const dugmeler = document.querySelectorAll<HTMLAnchorElement>('[data-tk-download]');
    if (!dugmeler.length) return;
    try {
      const r = await fetch('https://api.github.com/repos/YusufX-sys/turkod-ide/releases/latest');
      if (!r.ok) return;
      const veri = await r.json();
      const exe = (veri.assets || []).find((a: { name: string }) => a.name.toLowerCase().endsWith('.exe'));
      if (exe) dugmeler.forEach((d) => (d.href = exe.browser_download_url));
    } catch { /* sürümler sayfasında kalır */ }
  })();
</script>

<style is:global>
  /* ---------- Tema değişkenleri ---------- */
  :root[data-theme='dark'] {
    --tkl-surface: rgba(13, 17, 23, .72);
    --tkl-surface-solid: #0d1117;
    --tkl-border: rgba(129, 140, 248, .22);
    --tkl-heading: #f0f4fa;
    --tkl-text: #b8c2cf;
    --tkl-muted: #8b949e;
    --tkl-glow: rgba(99, 102, 241, .45);
    --tkl-code: #0b1020;
  }
  :root[data-theme='light'] {
    --tkl-surface: rgba(255, 255, 255, .85);
    --tkl-surface-solid: #ffffff;
    --tkl-border: rgba(99, 102, 241, .18);
    --tkl-heading: #111827;
    --tkl-text: #4b5563;
    --tkl-muted: #6b7280;
    --tkl-glow: rgba(99, 102, 241, .22);
    --tkl-code: #0f172a;
  }

  .tk-l { max-width: 72rem; margin-inline: auto; }
  .tk-l h2 { color: var(--tkl-heading); }
  .tk-grad-text {
    background: var(--tk-grad); background-size: 200% auto;
    -webkit-background-clip: text; background-clip: text; color: transparent;
    animation: tk-shine 6s linear infinite;
  }
  :root[data-theme='light'] .tk-grad-text { background-image: var(--tk-grad-light); }

  /* ---------- Bölüm başlıkları ---------- */
  .tk-section { margin-top: 6rem !important; }
  .tk-section-head { text-align: center; max-width: 42rem; margin: 0 auto 2.5rem; }
  .tk-section-head h2 { font-size: clamp(1.7rem, 3.4vw, 2.4rem); line-height: 1.15; margin: .5rem 0 0; letter-spacing: -.02em; }
  .tk-section-head p { color: var(--tkl-text); margin-top: .9rem; font-size: 1.05rem; }
  .tk-eyebrow {
    display: inline-block; padding: .3rem .8rem; border-radius: 999px;
    font-size: .78rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
    color: #22d3ee; background: rgba(34, 211, 238, .1); border: 1px solid rgba(34, 211, 238, .3);
  }
  .tk-eyebrow-violet { color: #c084fc; background: rgba(192, 132, 252, .1); border-color: rgba(192, 132, 252, .35); }
  :root[data-theme='light'] .tk-eyebrow { color: #0e7490; background: rgba(8, 145, 178, .08); border-color: rgba(8, 145, 178, .25); }
  :root[data-theme='light'] .tk-eyebrow-violet { color: #7e22ce; background: rgba(126, 34, 206, .07); border-color: rgba(126, 34, 206, .25); }

  /* ---------- Gradyan düğmeler ---------- */
  .tk-btn-grad, .tk-btn-line {
    display: inline-flex; align-items: center; gap: .55rem; padding: .8rem 1.4rem;
    border-radius: 999px; font-weight: 700; text-decoration: none !important; white-space: nowrap;
    transition: transform .25s, box-shadow .25s, background-position .4s, border-color .25s;
  }
  .tk-btn-grad svg { width: 1.15em; height: 1.15em; }
  .tk-btn-grad {
    color: #fff !important; background: linear-gradient(90deg, #06b6d4, #6366f1, #d946ef, #6366f1);
    background-size: 200% auto; box-shadow: 0 0 24px var(--tkl-glow);
  }
  .tk-btn-grad:hover { background-position: 100% center; transform: translateY(-3px); box-shadow: 0 0 36px rgba(217, 70, 239, .55); }
  .tk-btn-line { color: var(--tkl-heading) !important; border: 1px solid var(--tkl-border); background: var(--tkl-surface); }
  .tk-btn-line:hover { transform: translateY(-3px); border-color: #22d3ee; }
  .tk-btn-big { padding: 1rem 1.8rem; font-size: 1.05rem; }

  /* ---------- Ekran vitrini ---------- */
  .tk-showcase { position: relative; margin-top: 1rem !important; padding-bottom: 2rem; }
