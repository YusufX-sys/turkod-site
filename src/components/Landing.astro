---
// Ana sayfanın hero altındaki bölümleri. Sitenin mevcut görsel kimliğini
// (camgöbeği → çivit → eflatun gradyan, cam efektli kartlar) kullanır.
import { Image } from 'astro:assets';
import genelEkran from '../assets/v33/genel-ekran.webp';
import kodiCevap from '../assets/v33/kodi-cevap.webp';
import kodiEylem from '../assets/v33/kodi-eylem.webp';
import exePaneli from '../assets/v33/exe-paneli.webp';
import yerelAi from '../assets/v33/yerel-ai.webp';
import tarayiciKodi from '../assets/v33/tarayici-kodi.webp';
import pdfSekmesi from '../assets/v33/pdf-sekmesi.webp';
import akilliDuzelt from '../assets/v33/akilli-duzelt.webp';
import hataAyiklayici from '../assets/v33/hata-ayiklayici.webp';

const REPO = 'https://github.com/YusufX-sys/turkod-ide';

const ozellikler = [
  { renk: 'cyan', baslik: '%100 Türkçe dil', metin: '3000\'e yakın Türkçe karşılık: döngüler, fonksiyonlar, sınıflar, kaplumbağa, tkinter, pygame ve daha fazlası. Türkçe harfsiz yazım da çalışır.', link: '/learn/basics/', ikon: 'M4 6h16M4 12h10M4 18h7' },
  { renk: 'violet', baslik: 'Kodi, yapay zekâ arkadaşın', metin: 'Soruna cevap verir, hatanı bulur, kod yazar, menüleri senin için açar. Sesli konuşur, masaüstüne bile çıkar.', link: '/features/kodi/', ikon: 'M8 10h.01M16 10h.01M9 15c1.5 1 4.5 1 6 0M6 5h12a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z' },
  { renk: 'pink', baslik: 'Hayalet kod ve Akıllı Düzelt', metin: 'Yazarken satır içi öneriler gelir, Tab ile kabul edersin. Akıllı Düzelt hataları önce dener, sonra düzeltir.', link: '/features/smart-fix/', ikon: 'M12 3l1.9 4.6L19 9l-4 3.4 1.2 5.1L12 15l-4.2 2.5L9 12.4 5 9l5.1-1.4Z' },
  { renk: 'green', baslik: 'Yerel ve bulut yapay zekâ', metin: '220\'den fazla sağlayıcı ya da internetsiz çalışan yerel modeller. Ekran kartın varsa onu kullanır.', link: '/features/local-models/', ikon: 'M9 3v2M15 3v2M9 19v2M15 19v2M3 9h2M3 15h2M19 9h2M19 15h2M7 5h10a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z' },
  { renk: 'amber', baslik: 'EXE\'ye Dönüştür', metin: 'Oyununu tek bir .exe yap; TürKod kurulu olmayan arkadaşının bilgisayarında da çift tıklayınca çalışsın.', link: '/features/exe/', ikon: 'M12 3v12m0 0-4-4m4 4 4-4M5 21h14' },
  { renk: 'cyan', baslik: 'Gerçek hata ayıklayıcı', metin: 'Kesme noktaları, koşullu kesme noktası, izleme ifadeleri ve çağrı yığını. Programını adım adım izle.', link: '/features/run-debug/', ikon: 'M12 8v4l3 2M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z' },
  { renk: 'violet', baslik: 'Kitap programın içinde', metin: '"TürKod ile Kodlama Macerası" kitabı programla gelir; kendi PDF görüntüleyicisinde, yeni bir sekmede açılır.', link: '/whats-new/', ikon: 'M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2V5Zm0 16a2 2 0 0 1 2-2h13' },
  { renk: 'pink', baslik: 'Terminal ve komut satırı', metin: 'Her sekmenin kendi terminali, TürKod Kabuğu ve turkod komutu: --cevir, --duzelt, --anlam, exe_yap...', link: '/features/terminal/', ikon: 'M4 17l6-5-6-5M12 19h8' },
  { renk: 'green', baslik: 'İmzalı ve açık kaynak', metin: 'Uygulama, kaynak kod ve güncellemeler RSA ile imzalanır. Kodun tamamı MIT lisansıyla GitHub\'da.', link: '/features/security/', ikon: 'M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6Z M9 12l2 2 4-4' },
];

const galeri = [
  { id: 'exe', ad: 'EXE\'ye Dönüştür', resim: exePaneli, aciklama: 'Seçenekleri tikle seç, alttaki komut canlı değişsin. Programın tek bir .exe dosyası olur.' },
  { id: 'yerel', ad: 'Yerel Yapay Zekâ', resim: yerelAi, aciklama: 'Bilgisayarına uygun modeller önerilir; tek tıkla indirip internetsiz kullanırsın.' },
  { id: 'tarayici', ad: 'Tarayıcı', resim: tarayiciKodi, aciklama: 'TürKod\'un içinde bir tarayıcı. Kodi sayfaları açar, okur, senin için tıklar.' },
  { id: 'pdf', ad: 'PDF ve Kitap', resim: pdfSekmesi, aciklama: 'PDF dosyaları ve kitap yeni bir sekmede açılır; yakınlaştır, sayfa atla, hızlıca gez.' },
  { id: 'duzelt', ad: 'Akıllı Düzelt', resim: akilliDuzelt, aciklama: 'Hatalı kodu önce dener, düzeltmeyi gösterir; ne değiştiğini adım adım anlatır.' },
  { id: 'debug', ad: 'Hata Ayıklayıcı', resim: hataAyiklayici, aciklama: 'Kesme noktasında dur, değişkenlerin değerine bak, satır satır ilerle.' },
];
---

<section class="tk-l tk-showcase" aria-label="TürKod IDE ekran görüntüsü">
  <div class="tk-window">
    <div class="tk-window-bar">
      <span class="tk-d r"></span><span class="tk-d y"></span><span class="tk-d g"></span>
      <span class="tk-window-title">TürKod IDE 3.3</span>
    </div>
    <Image src={genelEkran} alt="TürKod IDE: gezgin, kod editörü, terminal ve AI Asistan paneli" loading="eager" widths={[720, 1080, 1424]} sizes="(max-width: 1100px) 100vw, 1100px" />
  </div>
  <div class="tk-float-kodi" aria-hidden="true">
    <Image src={kodiCevap} alt="" widths={[260, 489]} sizes="260px" />
  </div>
</section>

<section class="tk-l tk-metrics" aria-label="Kısaca TürKod">
  <div class="tk-metric"><strong>%100</strong><span>Türkçe arayüz ve hata mesajları</span></div>
  <div class="tk-metric"><strong>~3000</strong><span>Türkçe kelime karşılığı</span></div>
  <div class="tk-metric"><strong>220+</strong><span>yapay zekâ sağlayıcısı</span></div>
  <div class="tk-metric"><strong>MIT</strong><span>ücretsiz ve açık kaynak</span></div>
</section>

<section class="tk-l tk-section">
  <div class="tk-section-head">
    <span class="tk-eyebrow">Nasıl çalışır?</span>
    <h2>Python'un gücü, Türkçenin kolaylığı</h2>
    <p>Sen Türkçe yazarsın, TürKod arka planda gerçek Python'a çevirip çalıştırır. Hazır olduğunda aynı kodun Python hâlini tek tıkla görürsün.</p>
  </div>
  <div class="tk-compare">
    <div class="tk-code-card tk-code-tr">
      <div class="tk-code-head"><span class="tk-dot-tr"></span>tahmin_oyunu.trpy <em>TürKod</em></div>
<pre><code><span class="k">içe_aktar</span> rastgele

gizli_sayı = rastgele.<span class="f">tamsayı</span>(<span class="n">1</span>, <span class="n">10</span>)
hak = <span class="n">3</span>

<span class="k">döngü</span> hak &gt; <span class="n">0</span>:
    tahmin = <span class="f">tamsayı</span>(<span class="f">girdi_al</span>(<span class="s">"Tahminin: "</span>))
    <span class="k">eğer</span> tahmin == gizli_sayı:
        <span class="f">yazdır</span>(<span class="s">"Bildin! Tebrikler!"</span>)
        <span class="k">kır</span>
    <span class="k">değilse</span>:
        <span class="f">yazdır</span>(<span class="s">"Tekrar dene."</span>)
    hak = hak - <span class="n">1</span></code></pre>
    </div>
    <div class="tk-compare-arrow" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </div>
    <div class="tk-code-card tk-code-py">
      <div class="tk-code-head"><span class="tk-dot-py"></span>Python karşılığı <em>otomatik</em></div>
<pre><code><span class="k">import</span> random

gizli_sayı = random.<span class="f">randint</span>(<span class="n">1</span>, <span class="n">10</span>)
hak = <span class="n">3</span>

<span class="k">while</span> hak &gt; <span class="n">0</span>:
    tahmin = <span class="f">int</span>(<span class="f">input</span>(<span class="s">"Tahminin: "</span>))
    <span class="k">if</span> tahmin == gizli_sayı:
        <span class="f">print</span>(<span class="s">"Bildin! Tebrikler!"</span>)
        <span class="k">break</span>
    <span class="k">else</span>:
        <span class="f">print</span>(<span class="s">"Tekrar dene."</span>)
    hak = hak - <span class="n">1</span></code></pre>
    </div>
  </div>
</section>

<section class="tk-l tk-section">
  <div class="tk-section-head">
    <span class="tk-eyebrow">Özellikler</span>
    <h2>Öğrenmek için ihtiyacın olan her şey</h2>
    <p>Yeni başlayan biri için sade, büyüdükçe seninle büyüyecek kadar güçlü.</p>
  </div>
  <div class="tk-features">
    {ozellikler.map((o) => (
      <a class={`tk-feature tk-c-${o.renk}`} href={o.link}>
        <span class="tk-feature-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={o.ikon} /></svg>
        </span>
        <strong>{o.baslik}</strong>
        <span class="tk-feature-text">{o.metin}</span>
        <span class="tk-feature-more">Daha fazla <span aria-hidden="true">→</span></span>
      </a>
    ))}
  </div>
</section>

<section class="tk-l tk-section tk-kodi">
  <div class="tk-kodi-text">
    <span class="tk-eyebrow tk-eyebrow-violet">Yeni · TürKod 3.3</span>
    <h2>Tanış: <span class="tk-grad-text">Kodi</span></h2>
    <p>Kitaptaki robot Kodi artık programın içinde. F1'e bas, kayarak gelsin; sorunu yaz ya da söyle.</p>
    <ul class="tk-checks">
      <li><b>Hatanı bulur</b> ve hangi satırda olduğunu söyler, düzeltilmiş kodu verir.</li>
      <li><b>Senin için yapar:</b> panel açar, dosya açar, kod yazar, ayar değiştirir; önemli işlerden önce izin ister.</li>
      <li><b>Sesli konuşur:</b> mikrofona söyle, cevabı Türkçe sesle dinle.</li>
      <li><b>Masaüstüne çıkar</b> ve öteki pencerelerin üstünde seni bekler.</li>
      <li><b>Gizliliğe saygılı:</b> şifre, adres gibi özel bilgileri hatırlamaz; yetkilerini sen seçersin.</li>
    </ul>
    <a class="tk-btn-grad" href="/features/kodi/">Kodi'yi tanı <span aria-hidden="true">→</span></a>
  </div>
  <div class="tk-kodi-visual">
    <Image src={kodiEylem} alt="Kodi'nin konuşma balonu: kod yazmadan önce izin istiyor" widths={[360, 489]} sizes="(max-width: 800px) 90vw, 420px" />
  </div>
</section>

<section class="tk-l tk-section">
  <div class="tk-section-head">
    <span class="tk-eyebrow">Yakından bak</span>
    <h2>Programın içinde bir tur</h2>
  </div>
  <div class="tk-tabs" data-tk-tabs>
    <div class="tk-tablist" role="tablist" aria-label="Ekran görüntüleri">
      {galeri.map((g, i) => (
