        <p>{g.aciklama}</p>
        <div class="tk-tab-frame">
          <Image src={g.resim} alt={g.ad} widths={[640, 1000]} sizes="(max-width: 1000px) 100vw, 1000px" />
        </div>
      </div>
    ))}
  </div>
</section>

<section class="tk-l tk-section">
  <div class="tk-section-head">
    <span class="tk-eyebrow">Hemen başla</span>
    <h2>3 adımda ilk programın</h2>
  </div>
  <div class="tk-steps">
    <a class="tk-step" href="/releases/">
      <span class="tk-num">1</span>
      <span class="tk-step-body"><strong>İndir</strong><small>Sürüm Geçmişi sayfasından en yeni sürümü al</small></span>
      <span class="tk-arrow">→</span>
    </a>
    <a class="tk-step" href="/install/">
      <span class="tk-num">2</span>
      <span class="tk-step-body"><strong>Kur</strong><small>Yönetici izni gerekmez, ekrandaki adımları izle</small></span>
      <span class="tk-arrow">→</span>
    </a>
    <a class="tk-step" href="/use/first-run/">
      <span class="tk-num">3</span>
      <span class="tk-step-body"><strong>İlk kodunu yaz</strong><small>Ctrl+R'ye bas, programın çalışsın</small></span>
      <span class="tk-arrow">→</span>
